# Production .env for the server (copy to .env next to docker-compose.prod.yml). Never commit the real file.
# Generate secrets with: openssl rand -base64 32
DOMAIN=yourname.duckdns.org
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@postgres:5432/voice_notes
REDIS_URL=redis://redis:6379
WEB_ORIGIN=https://yourname.duckdns.org
BETTER_AUTH_URL=https://yourname.duckdns.org
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# --- Cloudflare R2 (audio) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=voice-notes-audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_BUCKET=voice-notes-backups         # scripts/backup.sh; the R2 token must be allowed to write here too
# --- AI: free stack ---
STT_PROVIDER=groq
NOTES_PROVIDER=groq
GROQ_API_KEY=
GROQ_NOTES_MODEL=openai/gpt-oss-120b
GROQ_NOTES_MAX_CHARS=16000
MONTHLY_MINUTES_LIMIT=600
