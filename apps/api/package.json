{
  "name": "@vn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOTENV_PATH=../../.env tsx watch src/server.ts",
    "worker": "DOTENV_PATH=../../.env tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src migrations scripts knexfile.ts",
    "test": "DOTENV_PATH=../../.env vitest run",
    "knex": "DOTENV_PATH=../../.env NODE_OPTIONS=\"--import tsx\" knex",
    "tsx": "DOTENV_PATH=../../.env tsx",
    "auth:migrate": "DOTENV_PATH=../../.env tsx scripts/auth-migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@vn/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "openai": "^7.27.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
